{
  "name": "local-coder-vscode",
  "displayName": "LOCAL-CODER: Autonomous AI Pair Programmer",
  "description": "High-performance in-editor AI pair programmer with inline edits (Ctrl+K), Composer (Ctrl+Shift+L), compiler gates, and local/frontier tiering.",
  "version": "1.0.6",
  "publisher": "pateldeep",
  "repository": {
    "type": "git",
    "url": "https://github.com/PatelDeepB/local-coder.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:local-coder.inlineEdit",
    "onCommand:local-coder.openComposer",
    "onCommand:local-coder.fixDiagnostics",
    "onCommand:local-coder.acceptDiff",
    "onCommand:local-coder.rejectDiff",
    "onCommand:local-coder.switchProvider",
    "onCommand:local-coder.commitChanges",
    "onCommand:local-coder.rollbackChanges",
    "onCommand:local-coder.testAndRepair",
    "onCommand:local-coder.startDaemon",
    "onCommand:local-coder.notifyTaskState",
    "onView:local-coder.chatView"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "local-coder.inlineEdit",
        "category": "Local Coder",
        "title": "Inline Edit (Ctrl+K / Ctrl+I)"
      },
      {
        "command": "local-coder.openComposer",
        "category": "Local Coder",
        "title": "Open Composer Sidebar (Ctrl+Shift+L)"
      },
      {
        "command": "local-coder.fixDiagnostics",
        "category": "Local Coder",
        "title": "Auto-Fix Diagnostics with Compiler Gate"
      },
      {
        "command": "local-coder.acceptDiff",
        "category": "Local Coder",
        "title": "Accept Inline Diff"
      },
      {
        "command": "local-coder.rejectDiff",
        "category": "Local Coder",
        "title": "Reject Inline Diff"
      },
      {
        "command": "local-coder.switchProvider",
        "category": "Local Coder",
        "title": "Switch Model Provider"
      },
      {
        "command": "local-coder.commitChanges",
        "category": "Local Coder",
        "title": "Commit Staged Edits"
      },
      {
        "command": "local-coder.rollbackChanges",
        "category": "Local Coder",
        "title": "Rollback Staged Edits"
      },
      {
        "command": "local-coder.testAndRepair",
        "category": "Local Coder",
        "title": "Autonomous Test & Repair Loop"
      },
      {
        "command": "local-coder.startDaemon",
        "category": "Local Coder",
        "title": "Start Background Server Daemon"
      },
      {
        "command": "local-coder.notifyTaskState",
        "category": "Local Coder",
        "title": "Notify Task Execution State"
      }
    ],
    "keybindings": [
      {
        "command": "local-coder.inlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && !localCoderDiffActive"
      },
      {
        "command": "local-coder.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !localCoderDiffActive"
      },
      {
        "command": "local-coder.inlineEdit",
        "key": "alt+k",
        "mac": "option+k",
        "when": "editorTextFocus && !localCoderDiffActive"
      },
      {
        "command": "local-coder.openComposer",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "local-coder.openComposer",
        "key": "alt+l",
        "mac": "option+l"
      },
      {
        "command": "local-coder.acceptDiff",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "localCoderDiffActive"
      },
      {
        "command": "local-coder.rejectDiff",
        "key": "escape",
        "when": "localCoderDiffActive"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "local-coder.inlineEdit",
          "when": "editorTextFocus",
          "group": "1_modification@1"
        },
        {
          "command": "local-coder.fixDiagnostics",
          "when": "editorTextFocus",
          "group": "1_modification@2"
        }
      ],
      "editor/title": [
        {
          "command": "local-coder.openComposer",
          "group": "navigation",
          "title": "Local Coder Composer"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "local-coder-sidebar",
          "title": "Local Coder",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "local-coder-sidebar": [
        {
          "type": "webview",
          "id": "local-coder.chatView",
          "name": "Composer & Agent"
        }
      ]
    },
    "configuration": {
      "title": "LOCAL-CODER",
      "properties": {
        "localCoder.apiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "Base URL of LOCAL-CODER FastAPI server daemon."
        },
        "localCoder.provider": {
          "type": "string",
          "enum": ["local", "ollama", "openai", "hybrid"],
          "default": "local",
          "description": "Active intelligence backend tier."
        },
        "localCoder.enableAutocomplete": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time predictive tab autocomplete (FIM speculative infilling)."
        }
      }
    }
  }
}
